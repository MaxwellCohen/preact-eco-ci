{
  "name": "demo-streaming",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.jsx --bundle --format=esm --platform=neutral --conditions=workerd,worker,import --main-fields=module,main --jsx=automatic --jsx-import-source=preact --outfile=dist/worker.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "preact": "*", "preact-render-to-string": "*" },
  "devDependencies": { "esbuild": "^0.25.0", "wrangler": "^4.0.0" }
}
